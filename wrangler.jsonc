{
  // Configuración de despliegue en Cloudflare.
  //
  // El sitio es estático: no hay código de servidor, este Worker solo sirve
  // los archivos de ./public. "name" debe coincidir exactamente con el nombre
  // del Worker en Cloudflare o el build falla.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awrisecr",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  }
}
